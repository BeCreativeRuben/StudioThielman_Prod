{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/",
      "destination": "/api/locale-redirect"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
